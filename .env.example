# Nexora Backend Environment Variables Template
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Database
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=nexora_dev;Username=postgres;Password=postgres

# Authentication
Authentication__Jwt__Issuer=Nexora.Api
Authentication__Jwt__Audience=Nexora.Frontend
Authentication__Jwt__SigningKey=change-this-to-a-secure-secret-key-at-least-32-chars-long
Authentication__RefreshCookie__SameSite=Lax
Authentication__RefreshCookie__Secure=false
Authentication__EmailVerification__PublicUrl=http://localhost:3000
Authentication__EmailVerification__TokenLifespanHours=24

# Email (noop for dev/test, resend for staging/prod)
Email__Provider=noop
Email__FromAddress=no-reply@example.com
Email__FromName=Nexora
Email__Resend__ApiKey=re_example_api_key
Email__Resend__ApiBaseUrl=https://api.resend.com
Email__Resend__TimeoutSeconds=15

# AI Provider
Ai__Provider=gemini
Ai__Gemini__ApiKey=
Ai__Gemini__Model=gemini-2.5-flash
Ai__DeepSeek__ApiKey=
Ai__DeepSeek__Model=deepseek-v4-flash

# Billing / Payments (fake for local, sepay for sandbox/prod)
Billing__Payment__Provider=fake
Billing__Sepay__Environment=Sandbox
Billing__Sepay__MerchantId=
Billing__Sepay__SecretKey=

# Storage
Storage__Local__RootPath=.nexora-local/storage

# Feature Gates
Features__Ai=true
Features__Payment=true
Features__Upload=true
