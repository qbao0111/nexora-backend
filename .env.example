# Nexora configuration catalogue. This file is an example only and is not
# loaded automatically. Use .NET user-secrets locally and a secret manager for
# Staging/Production. Never commit real credentials, tokens or connection
# strings.

# -----------------------------------------------------------------------------
# Environment and database
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
NEXORA_DEV_POSTGRES=Host=YOUR_DEV_BRANCH.neon.tech;Database=YOUR_DEV_DATABASE;Username=YOUR_DEV_ROLE;Password=replace-me;SSL Mode=Require
ConnectionStrings__Postgres=Host=YOUR_DEV_BRANCH.neon.tech;Database=YOUR_DEV_DATABASE;Username=YOUR_DEV_ROLE;Password=replace-me;SSL Mode=Require
# Optional offline/local Compose alternative:
# ConnectionStrings__Postgres=Host=localhost;Port=54329;Database=nexora_dev;Username=nexora_dev;Password=replace-me

# -----------------------------------------------------------------------------
# Authentication and public URLs
# -----------------------------------------------------------------------------
Authentication__Jwt__SigningKey=replace-with-at-least-32-random-characters
Authentication__Jwt__Issuer=Nexora.Api
Authentication__Jwt__Audience=Nexora.Frontend
Authentication__Jwt__AccessTokenMinutes=15
Authentication__Jwt__RefreshTokenDays=30
Authentication__RefreshCookie__SameSite=Lax
Authentication__RefreshCookie__Secure=false
Authentication__EmailVerification__PublicUrl=http://localhost:3000
Authentication__EmailVerification__TokenLifespanHours=24

# -----------------------------------------------------------------------------
# Frontend CORS (Development may use localhost; deployed environments require
# operator-supplied HTTPS frontend origins and never the backend URL.)
# -----------------------------------------------------------------------------
Frontend__AllowedOrigins__0=http://localhost:5173
Frontend__AllowedOrigins__1=http://127.0.0.1:5173
Frontend__AllowedOrigins__2=http://localhost:3000
Frontend__AllowedOrigins__3=http://127.0.0.1:3000
# Staging/Production example (set the real Vercel/custom frontend origin in the
# deployment dashboard; do not guess or commit it):
# Frontend__AllowedOrigins__0=https://YOUR-FRONTEND.example

# -----------------------------------------------------------------------------
# Private storage and upload limits
# -----------------------------------------------------------------------------
Storage__Provider=local
Storage__Local__RootPath=.nexora-local/storage
# Staging/Production use private Cloudflare R2; configure every value through
# secret/non-secret deployment settings, never in source control.
# Storage__Provider=r2
# Storage__R2__AccountId=replace-with-cloudflare-account-id
# Storage__R2__Bucket=replace-with-private-bucket-name
# Storage__R2__AccessKeyId=replace-with-r2-access-key-id
# Storage__R2__SecretAccessKey=replace-with-r2-secret-access-key
# Storage__R2__Endpoint=https://replace-with-account-id.r2.cloudflarestorage.com
Uploads__MaxResumeBytes=10485760
Uploads__IntentMinutes=10

# -----------------------------------------------------------------------------
# Email / Resend
# -----------------------------------------------------------------------------
Email__Provider=noop
Email__FromAddress=no-reply@example.com
Email__FromName=Nexora
Email__Resend__ApiKey=replace-with-resend-api-key
Email__Resend__ApiBaseUrl=https://api.resend.com
Email__Resend__TimeoutSeconds=15
# Staging/Production require Email__Provider=resend, a verified FromAddress,
# an API key, and an HTTPS Authentication__EmailVerification__PublicUrl.

# -----------------------------------------------------------------------------
# Sentry observability (optional in Development/Testing; required when
# deployed). Render can derive Sentry__Release from RENDER_GIT_COMMIT in the
# entrypoint when Sentry__Release is left empty.
# -----------------------------------------------------------------------------
Sentry__Dsn=
Sentry__Release=
# RENDER_GIT_COMMIT is supplied by Render; do not hard-code it here.

# -----------------------------------------------------------------------------
# AI provider (development/testing adapters; production provider remains DEC-01)
# -----------------------------------------------------------------------------
Ai__Provider=Gemini
Ai__Gemini__ApiKey=replace-with-gemini-development-key
Ai__Gemini__Model=replace-with-approved-development-model
Ai__Gemini__TimeoutSeconds=60
# Ai__Provider=DeepSeek
# Ai__DeepSeek__ApiKey=replace-with-deepseek-development-key
# Ai__DeepSeek__Model=deepseek-v4-flash
# The deterministic FakeAiProvider is test-harness-only and is not a runtime
# value for Ai__Provider.

# -----------------------------------------------------------------------------
# Billing (fake locally; SePay Sandbox only when explicitly configured)
# -----------------------------------------------------------------------------
Billing__Payment__Provider=fake
Billing__FakePayment__WebhookSecret=replace-with-local-development-secret
Billing__FakePayment__TimestampToleranceMinutes=5
# Billing__Payment__Provider=sepay
# Billing__Sepay__Environment=Sandbox
# Billing__Sepay__MerchantId=replace-with-sandbox-merchant-id
# Billing__Sepay__SecretKey=replace-with-sandbox-secret-key
# Billing__Sepay__CheckoutUrl=https://pay-sandbox.sepay.vn/v1/checkout/init
# Billing__Sepay__ApiBaseUrl=https://pgapi-sandbox.sepay.vn
# Billing__Sepay__PaymentMethod=BANK_TRANSFER
# Billing__Sepay__SuccessUrl=https://YOUR-FRONTEND.example/payment/success
# Billing__Sepay__ErrorUrl=https://YOUR-FRONTEND.example/payment/error
# Billing__Sepay__CancelUrl=https://YOUR-FRONTEND.example/payment/cancel

# -----------------------------------------------------------------------------
# Worker, realtime, health and feature flags
# -----------------------------------------------------------------------------
Worker__Polling__BusyDelayMilliseconds=25
Worker__Polling__IdleInitialDelayMilliseconds=250
Worker__Polling__IdleMaximumDelayMilliseconds=5000
Worker__Polling__IdleBackoffMultiplier=2
Worker__Polling__FailureDelayMilliseconds=5000
Realtime__Enabled=true
Realtime__BatchSize=50
Realtime__BusyDelayMilliseconds=200
Realtime__IdleDelayMilliseconds=1500
Realtime__FailureDelayMilliseconds=3000
OperationsHealth__MaxQueueLagMinutes=10
OperationsHealth__MaxPaymentPendingMinutes=60
OperationsHealth__RecentFailureWindowMinutes=15
Features__Ai=true
Features__Payment=true
Features__Upload=true
