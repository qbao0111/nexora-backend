# Copy into environment variables or .NET user-secrets. This file is not loaded automatically.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=nexora;Username=nexora;Password=replace-me
Authentication__Jwt__SigningKey=replace-with-at-least-32-random-characters
Authentication__Jwt__Issuer=Nexora.Api
Authentication__Jwt__Audience=Nexora.Frontend
Storage__Local__RootPath=.nexora-storage
