# Copy to /opt/nexora/.env.production, chmod 600; replace placeholders privately.
# Never source this file in a shell or commit real values.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ConnectionStrings__Postgres='Host=REPLACE_NEON_HOST;Database=REPLACE_DATABASE;Username=REPLACE_USER;Password=REPLACE_PASSWORD;SSL Mode=VerifyFull'
Authentication__Jwt__Issuer=Nexora.Api
Authentication__Jwt__Audience=Nexora.Frontend
Authentication__Jwt__SigningKey=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
Authentication__Jwt__AccessTokenMinutes=15
Authentication__Jwt__RefreshTokenDays=30
Authentication__RefreshCookie__SameSite=Strict
Authentication__RefreshCookie__Secure=true
Authentication__EmailVerification__PublicUrl=https://www.nexorainterview.io.vn
Authentication__EmailVerification__TokenLifespanHours=24
Frontend__AllowedOrigins__0=https://www.nexorainterview.io.vn
Frontend__AllowedOrigins__1=https://nexorainterview.io.vn
AllowedHosts=api.nexorainterview.io.vn;localhost;127.0.0.1

Storage__Provider=r2
Storage__R2__AccountId=REPLACE_ACCOUNT_ID
Storage__R2__Bucket=REPLACE_PRIVATE_BUCKET
Storage__R2__AccessKeyId=REPLACE_ACCESS_KEY
Storage__R2__SecretAccessKey=REPLACE_SECRET_KEY
Storage__R2__Endpoint=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
Features__Upload=true

# ProductionSafety currently blocks AI/Payment enablement (DEC-01/02).
# Keep false until separately approved source changes resolve those gates.
Features__Ai=false
Ai__Provider=deepseek
Ai__DeepSeek__BaseUrl=https://api.deepseek.com
Ai__DeepSeek__ApiKey=REPLACE_AI_KEY
Ai__DeepSeek__Model=deepseek-v4-flash
Ai__DeepSeek__TimeoutSeconds=60
Ai__DeepSeek__MaxAttempts=1
# Current per-purpose reasoning defaults remain in appsettings.json; no retry/budget overrides.
# Gemini is opt-in, not needed for DeepSeek: Ai__Gemini__ApiKey, Ai__Gemini__Model.

Features__Speech=false
Speech__Azure__Key=REPLACE_AZURE_SPEECH_KEY
Speech__Azure__Region=REPLACE_AZURE_REGION
Speech__Azure__TimeoutSeconds=10
Speech__Azure__ServerRefreshMinutes=8
Speech__Azure__ClientUsableMinutes=9

Email__Provider=resend
# Must be an existing verified Resend sender, NOT the public Gmail contact.
Email__FromAddress=REPLACE_VERIFIED_SENDER@example.com
Email__FromName=Nexora
Email__Resend__ApiKey=REPLACE_RESEND_KEY
Email__Resend__ApiBaseUrl=https://api.resend.com
Email__Resend__TimeoutSeconds=15

Features__Payment=false
Billing__Payment__Provider=payos
Billing__Payos__ClientId=REPLACE_PAYOS_CLIENT_ID
Billing__Payos__ApiKey=REPLACE_PAYOS_API_KEY
Billing__Payos__ChecksumKey=REPLACE_PAYOS_CHECKSUM_KEY
Billing__Payos__ReturnUrl=https://www.nexorainterview.io.vn/billing
Billing__Payos__CancelUrl=https://www.nexorainterview.io.vn/billing
Billing__Payos__TimeoutSeconds=15
# Confirm existing frontend callback routes with product owner before enabling payments.

Sentry__Dsn=
# Compose sets Sentry__Release=nexora-backend@<image SHA> for both processes.
Sentry__Release=REPLACED_BY_COMPOSE_IMAGE_SHA
Realtime__Enabled=true
Realtime__BatchSize=50
Realtime__BusyDelayMilliseconds=200
Realtime__IdleDelayMilliseconds=1500
Realtime__FailureDelayMilliseconds=3000
Worker__Polling__BusyDelayMilliseconds=25
Worker__Polling__IdleInitialDelayMilliseconds=250
Worker__Polling__IdleMaximumDelayMilliseconds=5000
Worker__Polling__IdleBackoffMultiplier=2
Worker__Polling__FailureDelayMilliseconds=5000
