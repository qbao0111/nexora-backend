{
  "Storage": {
    "Local": {
      "RootPath": ".nexora-local/storage"
    }
  },
  "Billing": {
    "Payment": {
      "Provider": "fake"
    },
    "FakePayment": {
      "WebhookSecret": "nexora-local-development-only-webhook-secret",
      "TimestampToleranceMinutes": 5
    },
    "Vnpay": {
      "Environment": "Sandbox",
      "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
      "QueryUrl": "https://sandbox.vnpayment.vn/merchant_webapi/api/transaction",
      "Locale": "vn",
      "OrderType": "other",
      "ExpireMinutes": 15,
      "TimeoutSeconds": 35
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
