{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=nexora_tests"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "Nexora.Tests",
      "Audience": "Nexora.Tests.Client",
      "SigningKey": "integration-test-signing-key-32-characters-minimum",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    }
  },
  "Storage": {
    "Provider": "local",
    "Local": {
      "RootPath": ".nexora-storage/tests"
    }
  },
  "Ai": {
    "Provider": "gemini",
    "Gemini": {
      "ApiKey": "test-only-not-used",
      "Model": "test-gemini-model"
    }
  }
}
