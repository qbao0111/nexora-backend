{
  "RateLimits": {
    "Disabled": true
  },
  "Authentication": {
    "Jwt": {
      "SigningKey": "nexora-local-development-only-signing-key-change-me"
    },
    "RefreshCookie": {
      "SameSite": "Lax",
      "Secure": false
    }
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173",
      "http://localhost:5088",
      "http://127.0.0.1:5088"
    ]
  },
  "Storage": {
    "Local": {
      "RootPath": ".nexora-local/storage"
    }
  },
  "Billing": {
    "Payment": {
      "Provider": "fake"
    },
    "FakePayment": {
      "WebhookSecret": "nexora-local-development-only-webhook-secret",
      "TimestampToleranceMinutes": 5
    },
    "MoMo": {
      "Environment": "Sandbox",
      "TimeoutSeconds": 35
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
