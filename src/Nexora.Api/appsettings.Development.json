{
  "RateLimits": {
    "Disabled": true
  },
  "Authentication": {
    "Jwt": {
      "SigningKey": "nexora-local-development-only-signing-key-change-me"
    }
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Storage": {
    "Local": {
      "RootPath": ".nexora-local/storage"
    }
  },
  "Billing": {
    "FakePayment": {
      "WebhookSecret": "nexora-local-development-only-webhook-secret",
      "TimestampToleranceMinutes": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
