{
  "ConnectionStrings": { "Postgres": "" },
  "Authentication": {
    "Jwt": {
      "Issuer": "Nexora.Api",
      "Audience": "Nexora.Frontend",
      "SigningKey": "",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    },
    "RefreshCookie": {
      "SameSite": "Strict",
      "Secure": true
    }
  },
  "Frontend": { "AllowedOrigins": [] },
  "Storage": { "Local": { "RootPath": ".nexora-storage" } },
  "Uploads": { "MaxResumeBytes": 10485760, "IntentMinutes": 10 },
  "Ai": {
    "Gemini": {
      "ApiKey": "",
      "Model": "",
      "TimeoutSeconds": 60,
      "MaxAttempts": 2,
      "RetryBaseDelayMilliseconds": 250
    }
  },
  "Features": { "Ai": true, "Payment": true, "Upload": true },
  "Billing": {
    "Payment": { "Provider": "fake" },
    "MoMo": {
      "Environment": "Sandbox",
      "PartnerCode": "",
      "AccessKey": "",
      "SecretKey": "",
      "RedirectUrl": "",
      "IpnUrl": "",
      "TimeoutSeconds": 35
    }
  },
  "RateLimits": {
    "Authentication": { "PermitLimit": 5, "WindowMinutes": 15 },
    "LoginEmail": { "PermitLimit": 10, "WindowMinutes": 15 },
    "Refresh": { "PermitLimit": 30, "WindowMinutes": 60 },
    "Upload": { "PermitLimit": 10, "WindowMinutes": 60 },
    "Checkout": { "PermitLimit": 5, "WindowMinutes": 60 },
    "AiJob": { "PermitLimit": 10, "WindowMinutes": 60 },
    "Answer": { "PermitLimit": 20, "WindowMinutes": 5 }
  },
  "OperationsHealth": {
    "MaxQueueLagMinutes": 10,
    "MaxPaymentPendingMinutes": 60,
    "RecentFailureWindowMinutes": 15
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
